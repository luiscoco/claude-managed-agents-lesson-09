{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "test", "vite.config.ts", "playwright.config.ts"]
}
